/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* 顶部留白统一到各页一致（--sp-3） */
  padding: var(--sp-3) var(--sp-4) 0;
}

/* ===== 个人信息卡 ===== */
/* 竖向居中：头像在上、两行文字在下，整组水平居中，与 navbar「我的」对齐 */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-4) var(--sp-4);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.profile-avatar {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--surface-2);
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--hairline);
}

.profile-info {
  width: 100%;
  text-align: center;
}

.profile-nickname {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「点击编辑头像与昵称」：整段文字居中 */
.profile-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  text-align: center;
}

/* ===== 底部操作区 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

/* 底部按钮：shadcn 主按钮范式——近黑底白字（--ink / --primary-fg）。
    danger 变体覆盖为红描边淡红底（退出登录不是主流程动作） */
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-card);
  font-size: var(--fs-body);
  font-weight: 600;
  background: var(--ink);
  color: var(--primary-fg);
}

/* 危险操作：红色描边 + 红字，不用实底（退出登录不是主流程动作） */
.footer-btn--danger {
  color: var(--danger);
  border: 1px solid var(--danger-border); /* 第8条例外：状态色描边，不适用中性 --hairline */
  background: var(--danger-tint);
}

.footer-hint {
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* ===== 编辑资料弹窗 ===== */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 原生 button 清掉默认样式：无边框无底色，尺寸自负。
   button 的默认样式各端差异大，必须显式清（含 ::after 边框） */
.avatar-picker {
  margin: 0;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

/* 原生 button 自带的 ::after 边框：WXSS 禁写双冒号，用单冒号 */
.avatar-picker:after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--surface-2);
  border: var(--hairline);
}

/* 空头像：与个人资料页的空头像同一套（次级面底 + user 图标） */
.edit-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-field {
  width: 100%;
  margin-top: var(--sp-4);
}

.edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

.edit-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

/* 超长提示行：红色（涨跌语义里的「警告」位），仅超长时出现 */
.edit-tip {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--danger);
  text-align: center;
}

.nickname-action {
  display: flex;
  justify-content: center;
  margin-top: var(--sp-3);
}

.nickname-link {
  padding: var(--sp-1) var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--accent);
  border-radius: var(--r-tag);
  display: flex; align-items: center; justify-content: center; min-height: 88rpx;
}


