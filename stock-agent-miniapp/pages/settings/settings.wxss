/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* 顶部留白统一到各页一致（--sp-3） */
  padding: var(--sp-3) var(--sp-4) 0;
}

/* ===== 个人信息卡 ===== */
.profile-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
}

.profile-card--hover {
  background: var(--press);
}

.profile-avatar {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--surface-2);
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--hairline);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-nickname {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* ===== 偏好设置分组 ===== */
.pref-group {
  margin-top: var(--sp-4);
}

/* 分组标题与卡片的间距刻意比区块间距小一档：标题才「属于」下面的卡片 */
/* 分组标题：与提醒页同一层级（比字段说明高一层） */
.group-title {
  margin-bottom: var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 600;
  color: var(--ink-2);
}

.pref-card {
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.pref-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  min-height: 96rpx;
  border-bottom: var(--hairline);}

.pref-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-tag);
  background: var(--surface-2);
  border: var(--hairline);
}

/* 开关打开时图标托底跟进主行动色（浅色主题下为蓝） */
/* 开关打开时图标容器同步「选中态」：近黑底白图标，与 chip 选中一致 */
.pref-icon-wrap--on {
  border-color: var(--ink);
  background: var(--ink);
}

.pref-text {
  flex: 1;
  min-width: 0;
}

.pref-title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.pref-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
}

/* 原生 switch：平台仅支持改 color，其余用组件默认 */
.pref-switch {
  flex: none;
  transform: scale(0.9);
  transform-origin: right center;
}

/* ===== 底部操作区 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

/* 底部按钮：shadcn 主按钮范式——近黑底白字（--ink / --primary-fg）。
    danger 变体覆盖为红描边淡红底（退出登录不是主流程动作） */
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-card);
  font-size: var(--fs-body);
  font-weight: 600;
  background: var(--ink);
  color: var(--primary-fg);
}

/* 危险操作：红色描边 + 红字，不用实底（退出登录不是主流程动作） */
.footer-btn--danger {
  color: var(--danger);
  border: 1px solid var(--danger-border); /* 第8条例外：状态色描边，不适用中性 --hairline */
  background: var(--danger-tint);
}

.footer-btn--danger-hover {
  /* 按压改「深红底 + 白字」：原先是红底+红字，按下后文字直接消失 */
  color: var(--primary-fg);
  border-color: var(--danger-strong);
  background: var(--danger-tint);
}

.footer-hint {
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* ===== 编辑资料弹窗 ===== */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 原生 button 清掉默认样式：无边框无底色，尺寸自负。
   button 的默认样式各端差异大，必须显式清（含 ::after 边框） */
.avatar-picker {
  margin: 0;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

/* 原生 button 自带的 ::after 边框：WXSS 禁写双冒号，用单冒号 */
.avatar-picker:after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--surface-2);
  border: var(--hairline);
}

/* 空头像：与个人资料页的空头像同一套（次级面底 + user 图标） */
.edit-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-field {
  width: 100%;
  margin-top: var(--sp-4);
}

.edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

.edit-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

/* 超长提示行：红色（涨跌语义里的「警告」位），仅超长时出现 */
.edit-tip {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--danger);
  text-align: center;
}

.nickname-action {
  display: flex;
  justify-content: center;
  margin-top: var(--sp-3);
}

.nickname-link {
  padding: var(--sp-1) var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--accent);
  border-radius: var(--r-tag);
  display: flex; align-items: center; justify-content: center; min-height: 88rpx;
}

.nickname-link--hover {
  background: var(--accent-tint);
}
