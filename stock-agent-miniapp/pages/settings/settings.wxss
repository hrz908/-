/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: var(--sp-3) var(--sp-4);
}

/* ===== 个人信息卡 ===== */
.profile-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
}

.profile-card--hover {
  background: var(--surface-2);
}

.profile-avatar {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--surface-2);
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-nickname {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 偏好设置分组 ===== */
.pref-group {
  margin-top: var(--sp-4);
}

/* 分组标题与卡片的间距刻意比区块间距小一档：标题才「属于」下面的卡片 */
.group-title {
  margin-bottom: var(--sp-2);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.pref-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
  overflow: hidden;
}

.pref-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--pad-card);
}

.pref-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-tag);
  background: var(--surface-2);
  border: 1px solid var(--line);
}

/* 开关打开时图标托底色跟进，只此一处用金色（行动点） */
.pref-icon-wrap--on {
  border-color: #5A4A1E;
  background: rgba(233, 185, 73, 0.10);
}

.pref-text {
  flex: 1;
  min-width: 0;
}

.pref-title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
}

.pref-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 原生 switch：平台仅支持改 color，其余用组件默认 */
.pref-switch {
  flex: none;
  transform: scale(0.9);
  transform-origin: right center;
}

/* ===== 底部操作区 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-card);
  font-size: var(--fs-body);
  font-weight: 600;
}

/* 危险操作：红色描边 + 红字，不用实底（退出登录不是主流程动作） */
.footer-btn--danger {
  color: var(--up);
  border: 1px solid rgba(242, 85, 90, 0.45);
  background: rgba(242, 85, 90, 0.08);
}

.footer-btn--danger-hover {
  background: rgba(242, 85, 90, 0.16);
}

.footer-hint {
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* ===== 编辑资料弹窗 ===== */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 原生 button 清掉默认样式：无边框无底色，尺寸自负。
   button 的默认样式各端差异大，必须显式清（含 ::after 边框） */
.avatar-picker {
  margin: 0;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

/* 原生 button 自带的 ::after 边框：WXSS 禁写双冒号，用单冒号 */
.avatar-picker:after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--surface-2);
  border: 1px solid var(--line);
}

.edit-field {
  width: 100%;
  margin-top: var(--sp-4);
}

.edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
}

.edit-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

/* 超长提示行：红色（涨跌语义里的「警告」位），仅超长时出现 */
.edit-tip {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--up);
  text-align: center;
}

.nickname-action {
  display: flex;
  justify-content: center;
  margin-top: var(--sp-3);
}

.nickname-link {
  padding: var(--sp-1) var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--accent);
  border-radius: var(--r-tag);
}

.nickname-link--hover {
  background: rgba(233, 185, 73, 0.10);
}
