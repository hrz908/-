<!-- 页面骨架与其它子页面（about / watchlist / alerts）保持一致：
     navbar + scroll-view(content) + TDesign cell-group(theme=card)。
     content 本身不加内边距，卡片的外边距与圆角对齐 t-cell-group--card
     （左右 32rpx、圆角 18rpx），个人信息卡与退出登录是自绘块，同一套边距 -->
<view class="page">
  <t-navbar title="我的" left-arrow="{{true}}" placeholder="{{true}}" bind:go-back="goBack" />

  <scroll-view class="content" scroll-y>
    <!-- 个人信息：整块可点。已登录点开编辑资料，未登录则引导去授权登录 -->
    <view class="profile-card" hover-class="profile-card--hover" bindtap="onProfileTap">
      <!-- 头像不给图标，没图时就是一块灰底。
           不用 t-avatar：组件内部自带一个默认底色的小圆，外露出来就是
           「大灰圈里叠个小圈」，普通 view/image 画圆反而干净 -->
      <image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="profile-avatar"></view>
      <view class="profile-info">
        <!-- 未登录时不显示「微信用户」，直接写「未登录」，避免看起来像已有一份资料 -->
        <view class="profile-nickname">{{isLoggedIn ? nickname : '未登录'}}</view>
        <!-- 微信号没有任何接口能拿到（wx.login 只给 openid），没填过就显示「未获取」 -->
        <view class="profile-wxid">微信号：{{wechatId || '未获取'}}</view>
      </view>
      <!-- 颜色用 CSS 变量而不是写死：t-icon 会把 color 原样拼进 style，
           var() 在这里能正常解析 -->
      <t-icon name="chevron-right" size="36rpx" color="var(--c-gray-light)" />
    </view>

    <!-- 偏好设置 -->
    <t-cell-group theme="card" bordered="{{true}}" title="偏好设置" t-class-title="pref-title">
      <t-cell title="消息推送" description="接收订单状态与活动提醒">
        <view slot="left-icon" class="icon-wrap {{pushEnabled ? 'icon-wrap--on' : ''}}">
          <!-- 图标名必须是图标库里真实存在的：之前写 bell 是空白，
               notification 才是这个版本里有的（聊天页「提醒」用的也是它） -->
          <t-icon name="notification" size="40rpx" color="{{pushEnabled ? 'var(--c-blue)' : 'var(--c-gray)'}}" />
        </view>
        <t-switch slot="note" value="{{pushEnabled}}" bind:change="onTogglePush" />
      </t-cell>
    </t-cell-group>

    <!-- 底部主按键：登录 / 退出登录占同一个位置，按登录态切换 -->
    <view class="footer">
      <view
        wx:if="{{isLoggedIn}}"
        class="footer-btn footer-btn--danger"
        hover-class="footer-btn--danger-hover"
        bindtap="onLogout"
      >退出登录</view>
      <view
        wx:else
        class="footer-btn footer-btn--primary"
        hover-class="footer-btn--primary-hover"
        bindtap="openLogin"
      >登录</view>
      <view class="footer-hint">{{isLoggedIn ? '退出后需重新登录，本地缓存将保留' : '使用微信身份登录，无需注册'}}</view>
    </view>
  </scroll-view>

  <!-- 编辑资料：确认/取消直接用 t-dialog 自带的底部按钮，
       与「添加自选股」弹窗一致（组件不会自动关闭，由事件里显式关） -->
  <t-dialog
    visible="{{profileVisible}}"
    title="编辑资料"
    confirm-btn="保存"
    cancel-btn="取消"
    bind:confirm="saveProfile"
    bind:cancel="cancelEdit"
    custom-style="--td-popup-transition: opacity 300ms ease; transform: translate3d(-50%, -50%, 0);"
  >
    <view slot="content" class="edit-form">
      <!-- 换头像的入口就是头像本身。必须用原生 button 的 open-type="chooseAvatar"
           （面板里才有「使用微信头像」）——t-button 是自定义组件，chooseavatar
           这个原生事件不一定能透出来。原生 button 的默认样式由 .avatar-picker 清掉 -->
      <button
        class="avatar-picker"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseWechatAvatar"
      >
        <!-- 同主页面：普通 view/image，不用 t-avatar，避免组件内置小圆外露 -->
        <image wx:if="{{editAvatar}}" class="edit-avatar" src="{{editAvatar}}" mode="aspectFill" />
        <view wx:else class="edit-avatar"></view>
      </button>

      <view class="edit-field">
        <!-- align="center" 让输入文字与 placeholder 都居中。
             type 平时是 text，只有点了下方「使用微信昵称」才切成 nickname——
             否则每次聚焦输入框都会弹出微信的昵称候选栏，属于打扰。
             不用 maxlength 硬截断——截断了就永远超不过、没法提示，
             改为放开输入、由 JS 判长度，超了用 status=error + tips 在框下方提示 -->
        <t-input
          t-class="edit-input"
          type="{{nicknamePicking ? 'nickname' : 'text'}}"
          align="center"
          focus="{{nicknamePicking}}"
          value="{{editNickname}}"
          placeholder="请输入昵称"
          status="{{nicknameTip ? 'error' : 'default'}}"
          tips="{{nicknameTip}}"
          bind:change="onEditNickname"
          bind:blur="onNicknameBlur"
        />

        <!-- 「使用微信昵称」按键：平台没有读取昵称的 API，做不到点了直接填。
             点它才把输入框切成 nickname 类型并聚焦，微信此时会带出昵称候选，
             由用户本人点选填入；失焦后输入框恢复成普通 text -->
        <view class="nickname-action">
          <view class="nickname-link" hover-class="nickname-link--hover" bindtap="fillWechatNickname">
            使用微信昵称
          </view>
        </view>
      </view>
    </view>
  </t-dialog>

  <!-- 微信用户授权登录。
       头像和昵称微信都不允许静默读取，只能由用户本人点选/填写一次，
       所以弹窗里必须摆出这两项，而不是「点了登录就自动带上」 -->
  <t-dialog
    visible="{{loginVisible}}"
    title="微信用户授权登录"
    confirm-btn="登录"
    cancel-btn="取消"
    bind:confirm="submitLogin"
    bind:cancel="cancelLogin"
    custom-style="--td-popup-transition: opacity 300ms ease; transform: translate3d(-50%, -50%, 0);"
  >
    <!-- 复用编辑资料弹窗的排版：头像居中 + 居中输入框 + 「使用微信昵称」 -->
    <view slot="content" class="edit-form">
      <button
        class="avatar-picker"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseLoginAvatar"
      >
        <image wx:if="{{loginAvatar}}" class="edit-avatar" src="{{loginAvatar}}" mode="aspectFill" />
        <view wx:else class="edit-avatar"></view>
      </button>

      <view class="edit-field">
        <t-input
          t-class="edit-input"
          type="{{loginPicking ? 'nickname' : 'text'}}"
          align="center"
          focus="{{loginPicking}}"
          value="{{loginNickname}}"
          placeholder="请输入昵称"
          status="{{loginTip ? 'error' : 'default'}}"
          tips="{{loginTip}}"
          bind:change="onLoginNickname"
          bind:blur="onLoginNicknameBlur"
        />

        <view class="nickname-action">
          <view class="nickname-link" hover-class="nickname-link--hover" bindtap="fillLoginNickname">
            使用微信昵称
          </view>
        </view>
      </view>
    </view>
  </t-dialog>

  <!-- 退出登录二次确认 -->
  <t-dialog
    visible="{{logoutVisible}}"
    title="退出登录"
    content="确定退出当前账号？本地缓存将保留"
    confirm-btn="退出登录"
    cancel-btn="取消"
    t-class-confirm="dialog-confirm--danger"
    bind:confirm="onLogoutConfirm"
    bind:cancel="onLogoutCancel"
    custom-style="--td-popup-transition: opacity 300ms ease; transform: translate3d(-50%, -50%, 0);"
  />

  <!-- 轻提示（TDesign toast，替代 wx.showToast） -->
  <t-toast id="t-toast" />
</view>
