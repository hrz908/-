<!-- 页面骨架：自研 navbar + 自绘卡片（替代 TDesign cell-group 体系）。
     深色专业终端视觉：--surface 卡片 / --line 描边 / --ink 文字层级。 -->
<view class="page">
  <base-navbar title="我的" left-arrow="{{true}}" bind:back="goBack" />

  <view class="content">
    <!-- 个人信息：整块可点，打开编辑资料弹窗。
         不用头像组件：没图时就是一块次级面底色 + user 图标，比组件内置小圆干净 -->
    <view class="profile-card" hover-class="profile-card--hover" bindtap="onProfileTap">
      <image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="profile-avatar profile-avatar--empty">
        <base-icon name="user" size="56rpx" color="var(--ink-3)" />
      </view>
      <view class="profile-info">
        <view class="profile-nickname">{{nickname}}</view>
      </view>
      <base-icon name="chevron-right" size="36rpx" color="var(--ink-3)" />
    </view>

    <!-- 偏好设置：自绘分组卡片 + 原生 switch（仅可改 color） -->
    <view class="pref-group">
      <view class="group-title">偏好设置</view>
      <view class="pref-card">
        <view class="pref-row">
          <view class="pref-icon-wrap {{pushEnabled ? 'pref-icon-wrap--on' : ''}}">
            <base-icon
              name="notification"
              size="40rpx"
              color="{{pushEnabled ? 'var(--accent)' : 'var(--ink-3)'}}"
            />
          </view>
          <view class="pref-text">
            <view class="pref-title">消息推送</view>
            <view class="pref-desc">接收订单状态与活动提醒</view>
          </view>
          <switch
            class="pref-switch"
            color="#E9B949"
            checked="{{pushEnabled}}"
            bindchange="onTogglePush"
          />
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作区：absolute 定位随页面转场移动，bottom 由安全区算出 -->
  <view class="bottom-btn" style="bottom: {{bottomGap}}px;">
    <view
      class="footer-btn footer-btn--danger"
      hover-class="footer-btn--danger-hover"
      bindtap="onLogout"
    >退出登录</view>
    <view class="footer-hint">退出后下次打开小程序会自动登录</view>
  </view>

  <!-- 编辑资料弹窗：base-popup center 模式，纯淡入（内含原生 input） -->
  <base-popup
    visible="{{profileVisible}}"
    mode="center"
    title="编辑资料"
    confirm-text="保存"
    cancel-text="取消"
    bind:confirm="saveProfile"
    bind:cancel="cancelEdit"
  >
    <view slot="content" class="edit-form">
      <!-- 换头像入口：必须用原生 button 的 open-type="chooseAvatar"（面板里才有
           「使用微信头像」）；自定义组件不一定能透出 chooseavatar 事件。
           原生 button 的默认样式由 .avatar-picker 清掉 -->
      <button
        class="avatar-picker"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseWechatAvatar"
      >
        <image wx:if="{{editAvatar}}" class="edit-avatar" src="{{editAvatar}}" mode="aspectFill" />
        <view wx:else class="edit-avatar edit-avatar--empty"></view>
      </button>

      <view class="edit-field">
        <!-- type 平时是 text，只有点了下方「使用微信昵称」才切成 nickname——
             否则每次聚焦输入框都会弹出微信昵称候选栏，属于打扰。
             focus 必须镜像「真实焦点」（focus 事件置 true、blur 置 false）：
             把已聚焦输入框的 focus 下发成 false 会让微信立刻收键盘，
             症状是「删除一个字符键盘就收起」；要主动收键盘用 wx.hideKeyboard()。 -->
        <input
          class="edit-input"
          type="{{nicknamePicking ? 'nickname' : 'text'}}"
          value="{{editNickname}}"
          placeholder="请输入昵称"
          placeholder-class="edit-input-placeholder"
          focus="{{nicknameFocus}}"
          hold-keyboard="{{true}}"
          bindinput="onEditNickname"
          bindblur="onNicknameBlur"
          bindfocus="onNicknameFocus"
          bindnicknamereview="onNicknameReview"
        />

        <!-- 超长提示行：空串不渲染（原 t-input tips 的位置，改为自绘） -->
        <view wx:if="{{nicknameTip}}" class="edit-tip">{{nicknameTip}}</view>

        <view class="nickname-action">
          <view class="nickname-link" hover-class="nickname-link--hover" bindtap="fillWechatNickname">
            使用微信昵称
          </view>
        </view>
      </view>
    </view>
  </base-popup>

  <!-- 退出登录二次确认：危险色确认按钮 -->
  <base-popup
    visible="{{logoutVisible}}"
    mode="center"
    title="退出登录"
    desc="确定退出当前账号？本地缓存将保留"
    confirm-text="退出登录"
    cancel-text="取消"
    confirm-danger="{{true}}"
    bind:confirm="onLogoutConfirm"
    bind:cancel="onLogoutCancel"
    bind:mask="onLogoutCancel"
  />

  <base-toast id="base-toast" />
</view>
