/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--sp-4);
}

/* ===== 总浮动概览卡 ===== */
.overview-card {
  flex: none;
  padding: var(--pad-card);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
}

.overview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.overview-title {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.overview-tags {
  display: flex;
  gap: var(--sp-1);
}

/* 小标签：圆角 6px + 边框 + 浅底（设计稿 .tag 规格） */
.mini-tag {
  padding: 3rpx 12rpx;
  border-radius: var(--r-tag);
  border: 1rpx solid var(--line);
  font-size: var(--fs-min);
  background: var(--surface-2);
  color: var(--ink-2);
  white-space: nowrap;
}

/* 浅底上的淡色标签：淡色底 + 同色系淡描边（深色主题那套深描边在浅底发脏） */
.mini-tag--up {
  border-color: var(--up-border);
  color: var(--up);
  background: var(--up-tint);
}

.mini-tag--down {
  border-color: var(--down-border);
  color: var(--down);
  background: var(--down-tint);
}

/* 总浮动金额：价格级字号 + 等宽 */
.hero-amount {
  margin-top: var(--sp-2);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.hero-amount.is-up {
  color: var(--up);
}

.hero-amount.is-down {
  color: var(--down);
}

.hero-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 刷新入口：顶部分隔线 + 次级面 */
.overview-refresh {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line);
}

.overview-refresh-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

.overview-refresh--hover {
  opacity: 0.75;
}

/* 刷新中：图标旋转（WXSS 动画可用，禁用的是 hover/active 伪类） */
.overview-refresh--spinning .refresh-icon {
  animation: refresh-spin 800ms linear infinite;
}

@keyframes refresh-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ===== 筛选 chips ===== */
.filter-tabs {
  flex: none;
  margin-top: var(--sp-3);
}

/* ===== 列表滚动区 =====
   底边让开悬浮的「添加股票」按钮：按钮距底 20 + 按钮高 48 + 与按钮间距 16 = 84，再加安全区。
   必须用 margin 而不是 padding：padding 会计入 scroll-view 的滚动内容高度，
   结果只有一只股票也会被撑出可滚动距离（能空拖一段） */
.stock-scroll {
  flex: 1;
  /* height:0 + flex:1 把高度完全交给 flex 分配；
     min-height:0 兜住 flex item 默认的「最小内容尺寸」限制 */
  height: 0;
  min-height: 0;
  margin-top: var(--sp-3);
  margin-bottom: 84px;
  margin-bottom: calc(84px + env(safe-area-inset-bottom));
}

.stock-list {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
  overflow: hidden;
}

/* ===== 自绘左滑行（替代 t-swipe-cell） ===== */
.stock-row {
  position: relative;
  overflow: hidden;
}

/* 主行：位移由 WXML 内联 transform 驱动（拖动中瞬移、松手过渡归位） */
.stock-row-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  transition: transform 200ms ease;
}

/* 拖动中关掉过渡：否则位移永远慢半拍 */
.stock-row--dragging .stock-row-main {
  transition: none;
}

.stock-row-main--hover {
  background: var(--surface-2);
}

/* 行与行之间的分隔线：sep 由 JS 按行号算好（WXSS 禁用兄弟选择器）。
   最后一条的分隔线由 .stock-list 的 overflow:hidden + 圆角裁掉 */
.stock-row-main--sep {
  border-top: 1rpx solid var(--line);
}

.stock-info {
  flex: 1;
  min-width: 0;
}

.stock-name {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-code {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.price-note {
  flex: none;
  text-align: right;
}

.p1 {
  font-size: 32rpx;
  font-weight: 600;
}

.p2 {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
}

.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* 左滑露出的删除区：绝对定位贴在主行之下，宽 128px（与 JS 的 SWIPE_ACTION_W 一致） */
.stock-row-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 128px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: var(--up);
}

.stock-row-action-text {
  font-size: var(--fs-min);
  color: #ffffff;
}

/* ===== 底部「添加股票」 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  height: 96rpx;
  border-radius: var(--r-card);
  background: var(--accent);
  box-shadow: 0 8rpx 24rpx rgba(37, 89, 235, 0.24);
}

.add-btn-text {
  font-size: var(--fs-body);
  font-weight: 600;
  /* 蓝底按钮上的文字反白（原金色底用深色字，主题切蓝后必须跟着换） */
  color: #FFFFFF;
}

.add-btn--hover {
  opacity: 0.88;
}

/* ===== 添加自选表单 ===== */
.add-form {
  padding-bottom: var(--sp-1);
}

.form-field {
  margin-top: var(--sp-3);
}

.form-label {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
}

.form-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

.form-error {
  margin-top: var(--sp-2);
  font-size: var(--fs-aux);
  color: var(--up);
}

/* 代码联想下拉：绝对定位浮在输入框下方，不挤压表单 */
.search-field {
  position: relative;
}

.search-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--sp-1);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  box-shadow: var(--shadow-pop);
  overflow: hidden;
  z-index: 10;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--line);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--fs-body);
  color: var(--ink);
}

.search-item-code {
  font-size: var(--fs-aux);
  color: var(--ink-3);
  font-feature-settings: 'tnum';
}

/* ===== 弹窗里的交易所提示：一行一个交易所 ===== */
.add-note {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 1rpx dashed var(--line);
}

.note-title {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.note-row {
  display: flex;
  align-items: baseline;
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

/* 标签列固定宽度，代码前缀才能上下对齐 */
.note-label {
  flex: 0 0 96rpx;
  color: var(--ink-2);
}

.note-codes {
  flex: 1;
  color: var(--ink-3);
}
