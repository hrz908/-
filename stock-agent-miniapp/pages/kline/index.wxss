/* K 线详情页：深色终端风。样式全部自绘（未引任何 UI 库），
   间距与字号沿用主包 token 的 rpx 档位，视觉与其它页一致 */
.page {
  min-height: 100vh;
  padding: var(--sp-3) var(--sp-4) var(--sp-5);
  background: var(--bg);
}

/* 周期 chips：激活项金色描边（单一强调色仅用于当前态） */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 var(--sp-2);
  box-sizing: border-box;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
}

.chip-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

.chip--on {
  background: rgba(233, 185, 73, 0.12);
  border-color: #5A4A1E;
}

.chip--on .chip-text {
  color: var(--accent);
  font-weight: 600;
}

.chip--hover {
  opacity: 0.85;
}

/* 图表卡：surface 底 + 描边，画布高度 520rpx（K 线区约 400rpx） */
.chart-card {
  position: relative;
  margin-top: var(--sp-3);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
  overflow: hidden;
}

.canvas {
  width: 100%;
  height: 520rpx;
}

/* 加载 / 空 / 错误遮罩：盖在画布上，不撑布局 */
.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 区间统计：四列 */
.stats {
  display: flex;
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
}

.stat {
  flex: 1;
  min-width: 0;
  padding-right: var(--gap-grid);
}

.stat:last-child {
  padding-right: 0;
}

.stat-k {
  font-size: var(--fs-min);
  color: var(--ink-3);
}

.stat-v {
  margin-top: 6rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* 口径与免责声明（合规：数据口径 + 不构成建议） */
.note {
  margin-top: var(--sp-3);
  font-size: var(--fs-min);
  line-height: 1.75;
  color: var(--ink-3);
}
