<!-- K 线详情页：自研导航栏 + 周期 chips（base-tabs）+ uCharts 画布 + 区间统计。
     画布触摸绑定 scroll/showToolTip（uCharts 实例方法），页面级 disableScroll
     开启，画布上再加 disable-scroll 双保险 -->
<view class="page">
  <!-- 导航栏与周期 chips 都用主包组件：标题字号、返回键、chips 规格与其余页面一致 -->
  <base-navbar title="{{titleText}}" left-arrow="{{true}}" bind:back="onBack" />

  <base-tabs class="period-tabs" items="{{periods}}" value="{{activePeriod}}" bind:change="onPeriodChange" />

  <view class="chart-card">
    <canvas
      type="2d"
      id="kline-canvas"
      class="canvas"
      disable-scroll="{{true}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    ></canvas>
    <view wx:if="{{loading}}" class="mask">加载中…</view>
    <view wx:elif="{{empty}}" class="mask">暂无 K 线数据</view>
    <view wx:elif="{{errorMsg}}" class="mask">{{errorMsg}}</view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="stat-k">区间涨跌幅</view>
      <view class="stat-v num {{stats.pctDir}}">{{stats.pctText}}</view>
    </view>
    <view class="stat">
      <view class="stat-k">区间振幅</view>
      <view class="stat-v num">{{stats.ampText}}</view>
    </view>
    <view class="stat">
      <view class="stat-k">区间最高</view>
      <view class="stat-v num up">{{stats.highText}}</view>
    </view>
    <view class="stat">
      <view class="stat-k">区间最低</view>
      <view class="stat-v num down">{{stats.lowText}}</view>
    </view>
  </view>

  <view class="note">
    <view>口径：前复权；均线为简单移动平均；区间涨跌幅与振幅按区间首末收盘价计算。</view>
    <view>行情数据存在延迟，仅供参考，不构成投资建议。</view>
  </view>
</view>
