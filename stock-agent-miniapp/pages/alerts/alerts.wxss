/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--sp-4);
}

/* ===== 概览宫格（替代 t-grid card 主题） ===== */
.overview {
  flex: none;
  display: flex;
  gap: var(--gap-grid);
}

.overview-cell {
  flex: 1;
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
}

.g-num {
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
}

.g-label {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* ===== 分组标题 ===== */
.group-title {
  flex: none;
  margin: var(--sp-4) 0 var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 600;
  color: var(--ink-2);
}

/* ===== 列表滚动区 =====
   底边让开悬浮的「新增提醒」按钮：按钮距底 20 + 按钮高 48 + 与按钮间距 16 = 84，再加安全区。
   必须用 margin 而不是 padding：padding 会计入 scroll-view 的滚动内容高度，
   结果只有一条提醒也会被撑出可滚动距离（能空拖一段） */
.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-bottom: 84px;
  margin-bottom: calc(84px + env(safe-area-inset-bottom));
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
}

/* ===== 提醒卡 ===== */
.alert-card {
  padding: var(--pad-card);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-card);
}

.alert-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.alert-card-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.alert-card-code {
  margin-left: var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 400;
  color: var(--ink-3);
}

/* 删除入口：次级文字 + 图标，弱化处理（不是主操作） */
.alert-card-edit {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-2);
  flex: none;
}

.alert-card-edit-text {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 大号阈值：价格级字号，等宽 + 涨跌色 */
.alert-card-price {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.alert-card-price-text {
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: 1.1;
}

.alert-card-desc {
  margin-top: var(--sp-2);
  font-size: var(--fs-aux);
  color: var(--ink-2);
  line-height: 1.6;
}

.alert-card-divider {
  height: 0;
  margin: var(--sp-3) 0;
  border-top: 1rpx solid var(--line);
}

.alert-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.alert-card-time {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* 状态标签：小药丸（设计稿 .tag 规格） */
.a-tag {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  font-size: var(--fs-min);
  white-space: nowrap;
}

.a-tag-text {
  color: var(--ink-2);
}

/* 已触发：未触发=中性；触发后跟随涨跌语义（跌=绿、涨=红）。
   浅底上用淡色底 + 同色系淡描边，深底那套深描边在白卡上会发脏 */
.a-tag--danger {
  border-color: var(--up-border);
  background: var(--up-tint);
}

.a-tag--danger .a-tag-text {
  color: var(--up);
}

.a-tag--success {
  border-color: var(--down-border);
  background: var(--down-tint);
}

.a-tag--success .a-tag-text {
  color: var(--down);
}

/* ===== 底部「新增提醒」 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  height: 96rpx;
  border-radius: var(--r-card);
  background: var(--accent);
  box-shadow: 0 8rpx 24rpx rgba(37, 89, 235, 0.24);
}

.add-btn-text {
  font-size: var(--fs-body);
  font-weight: 600;
  /* 蓝底按钮上的文字反白（原金色底用深色字，主题切蓝后必须跟着换） */
  color: #FFFFFF;
}

.add-btn--hover {
  opacity: 0.88;
}

/* ===== 新增提醒表单 ===== */
.form-section {
  margin-top: var(--sp-4);
}

.form-label {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 输入行：输入框 + 尾部单位 / 清除按钮 */
.input-wrap {
  position: relative;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
}

/* 带尾部单位时给右侧留位 */
.input-unit {
  position: absolute;
  right: var(--sp-3);
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  pointer-events: none;
}

.input-clear {
  position: absolute;
  right: var(--sp-2);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.input-clear--hover {
  background: var(--surface-2);
}

.form-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

/* 已选股票行 */
.selected-stock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
}

.selected-stock-text {
  font-size: var(--fs-aux);
  color: var(--ink);
}

/* 带标题的选择器行（替代 t-cell + arrow） */
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  min-height: 96rpx;
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
}

.option-row--hover {
  border-color: #3A4A5A;
}

/* 原生 picker 触发区：hover-class 加在 picker 根节点上，
   需要透传一层改内部行的边框色（WXSS 没有 :has，只能这样写） */
.option-picker {
  display: block;
  width: 100%;
}

.option-picker.option-row--hover .option-row {
  border-color: #3A4A5A;
}

.option-label {
  font-size: var(--fs-body);
  color: var(--ink);
}

.option-value {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  flex: none;
}

.option-value-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* ===== 代码联想下拉 ===== */
.search-field {
  position: relative;
}

.search-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--sp-1);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  box-shadow: var(--shadow-pop);
  overflow: hidden;
  z-index: 10;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--line);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--fs-body);
  color: var(--ink);
}

.search-item-code {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}
