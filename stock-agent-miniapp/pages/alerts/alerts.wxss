/* 页面只保留骨架与少量视觉微调，概览/筛选/列表全部交给 TDesign 组件 */

/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--c-bg);
  /* 底部按钮用 absolute 而非 fixed，转场时随页面整体移动 */
  position: relative;
  will-change: transform;
}

/* 中段骨架：概览宫格 + 筛选固定不动，剩余高度全部给列表滚动区 */
.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 列表滚动区：页面里唯一内部滚动的地方。
   底边让开悬浮的「新增提醒」按钮（absolute 定位，不在文档流）：
   预留 = 按钮距底 20 + 按钮高 52 + 与按钮的间距 16 = 88，再加安全区；
   env() 不支持时第二条声明失效，会退回上面那个固定值 */
.list-scroll {
  flex: 1;
  min-height: 0;
  margin-bottom: 88px;
  margin-bottom: calc(88px + env(safe-area-inset-bottom));
}

/* ===== 概览宫格（TDesign grid） ===== */
.overview-grid {
  display: block;
  /* navbar 之后第一个区块，用标准区块间距 --gap-block（32rpx）。
     它下面到筛选栏同样是 --gap-block，整页区块间距一致 */
  margin-top: var(--gap-block);
  background: var(--c-card);
}

.g-num {
  font-size: 22px;
  font-weight: 700;
}

.g-num.ink {
  color: var(--c-ink);
}

.g-num.blue {
  color: var(--c-blue);
}

.g-num.red {
  color: var(--c-red);
}

.g-label {
  margin-top: var(--sp-1);
  font-size: 12px;
  color: var(--c-gray);
}

/* ===== 筛选 tabs ===== */
.filter-tabs {
  display: block;
  margin-top: var(--gap-block);
  background: var(--c-card);
}

/* 列表里的分组：与上方筛选栏之间是区块间距，
   标题与它自己的卡片用 --gap-title（同一套规格，见 app.wxss） */
.list-group {
  display: block;
  margin-top: var(--gap-block);
}

.list-title {
  margin-bottom: var(--gap-title);
}

/* ===== cell 的 description 插槽内容（TDesign cell） ===== */
.a-desc-wrap {
  padding-top: var(--sp-1);
}

.a-desc {
  font-size: 12px;
  color: var(--c-gray);
}

.a-tags {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-top: var(--sp-2);
}

.a-time {
  font-size: 11px;
  color: var(--c-gray-light);
}

/* ===== 底部按钮（承载 TDesign button） ===== */
.bottom-btn {
  position: absolute;
  left: var(--pad-page);
  right: var(--pad-page);
  height: 52px;
}
