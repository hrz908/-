/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  /* 用 100% 而非 100vh：vh 是固定像素，键盘弹起时重算会与键盘动画不同步导致跳变 */
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  /* 自身作为定位容器：输入栏用 absolute 而非 fixed，
     页面转场动画期间不会因 fixed 元素单独定位而与页面错位 */
  position: relative;
}

/* ===== 导航栏 ===== */
.nav-left {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

/* ===== 对话区 ===== */
/* 高度由 JS 精算并固定为像素值：不随视口变化抖动，也不会被子元素撑开 */
.chat-wrap {
  flex: none;
  width: 100%;
  overflow: hidden;
}

.chat-scroll {
  height: 100%;
}

/* 水平留白放在滚动内容上，避免贴到屏幕边缘；
   底部再补 24rpx 内边距，滚到底时最新气泡不至于贴着容器边。
   overflow: hidden 让容器自成 BFC，子元素的 margin 不会溢出到容器外面 */
.chat-inner {
  padding: 0 var(--sp-3) var(--sp-3);
  overflow: hidden;
}

/* 组件给每条消息加了 margin-bottom: 32rpx，这个尾巴会一直挂在最后一条下面，
   导致「下方留白」永远比上方多一截（靠 :last-child 取消不可靠：
   页面上 :last-child 能不能命中组件根节点，取决于 styleIsolation 的实际表现）。
   干脆把间距改成 margin-top：
   - 消息之间仍是 32rpx（只由相邻两条的上边距决定，观感不变）；
   - 第一条上方是本容器的 32rpx 上边距，这就是它到导航栏的距离；
   - 最后一条下方彻底为 0（不再是 32rpx），剩下的只有到输入栏的那点布局间距 */
.chat-inner .t-chat-message {
  margin-bottom: 0;
  margin-top: var(--gap-block);
}

/* scroll-into-view 锚点：0 高度，仅用于把列表滚到底 */
.chat-anchor {
  height: 0;
}

/* ===== 状态提示（正在思考 / 工具查询 / 重连） ===== */
/* 与 AI 气泡同一套视觉语言：白底卡片、左上直角，挂在列表底部；
   不放进 chat-message 是因为它不是消息，done/error 后整块直接消失 */
.status-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: fit-content;
  max-width: 80%;
  margin-top: var(--gap-block);
  padding: var(--sp-2) var(--sp-3);
  background-color: var(--c-card);
  border-radius: 0 var(--td-radius-extraLarge, 24rpx) var(--td-radius-extraLarge, 24rpx) var(--td-radius-extraLarge, 24rpx);
  font-size: 26rpx;
  color: var(--c-gray);
}

/* 三个跳动小点：代替 loading 图标，错相延迟形成波浪感 */
.status-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--c-gray-light);
  animation: status-blink 1.2s infinite ease-in-out;
}

.status-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.status-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes status-blink {
  0%, 60%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* ===== 用户气泡：浅蓝底 + 白字，且不占满整行 ===== */
/* 组件默认是 .t-chat-message--base .t-chat-content 统一灰底、
   再用 --base.assistant 覆盖成透明，用户侧沿用灰底；
   这里只针对 user 侧覆写。多一层 .chat-inner 是为了压过组件内部那条
   .t-chat-message--base.user .t-chat-content 的优先级
   （chat-message.json 是 styleIsolation: shared，页面样式可作用于其内部节点） */
.chat-inner .t-chat-message--base.user .t-chat-content {
  background-color: var(--c-blue-bubble);
  /* 只在右对齐（__content align-items: flex-end）下有效：
     气泡宽度原本按内容一路撑到整行，给个上限后多出来的空间自动落在左侧。
     想留更多/更少改这个百分比即可 */
  max-width: 80%;
  /* 只写 color 不够：真正渲染文字的是内部的 .t-chat-content__user，
     它用 --td-chat-content-user-text-color 写死了主文本色，继承不到这里的 color。
     改组件自己的 token 是最稳的做法，变量会继承给内部节点 */
  --td-chat-content-user-text-color: #fff;
  color: #fff;
}

/* 兜底：万一变量没透传下去，直接按内部节点类名再压一次 */
.chat-inner .t-chat-content__user {
  color: #fff;
}

/* ===== AI 气泡：套上 TDesign 的对话消息体 ===== */
/* 组件对 base 变体的 assistant 侧写死了透明底 + 0 内边距（那是配合左侧头像的裸文本样式），
   页面已去掉头像，AI 文字就直接糊在背景上了。
   这里按它给 user 侧的同一套气泡规格补齐：24/32 内边距 + 左上角直角，
   底色用 --c-card 与结构化卡片一致。
   多一层 .chat-inner 同样是为了压过组件内部那条 assistant 规则的优先级 */
.chat-inner .t-chat-message--base.assistant .t-chat-content {
  /* 与结构化卡片同底：--c-card 就是 .card 的背景色，两者永远一致 */
  background-color: var(--c-card);
  padding: var(--sp-3) var(--sp-4);
  border-radius: 0 var(--td-radius-extraLarge, 24rpx) var(--td-radius-extraLarge, 24rpx) var(--td-radius-extraLarge, 24rpx);
}

/* AI 正文保留换行：组件只给 user/system 侧的 ._pre 开了 pre-wrap，
   assistant 侧没开，流式回复里的 \n 会被当成普通空白合并成一坨。
   chat-content 是 apply-shared，页面样式能作用到它内部的 ._pre 节点 */
.chat-inner .t-chat-content__assistant ._pre {
  margin: 0;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ===== 结构化卡片：行情卡 / 日 K 表 ===== */
/* 宽度占满一行：卡在 base 变体里是直接挂在 __detail 下的 slot，
   外层 __content 是 flex:1（头像已去掉，即整行宽），这里铺满即可 */
.card {
  width: 100%;
  box-sizing: border-box;
  padding: var(--sp-3);
  /* 与 AI 气泡共用同一个值 */
  background: var(--c-card);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 26, 28, 0.06);
}

.card-head {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-ink);
}

.card-sub {
  font-size: 22rpx;
  color: var(--c-gray);
}

.card-hero {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.hero-price {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero-change {
  font-size: 24rpx;
  font-weight: 500;
}

.card-grid {
  display: flex;
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--c-border);
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.grid-label {
  font-size: 22rpx;
  color: var(--c-gray);
}

.grid-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-ink);
}

.card-foot {
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--c-border);
  font-size: 22rpx;
  color: var(--c-gray);
}

/* ===== 日 K 表格 ===== */
.kline-table {
  margin-top: var(--sp-2);
}

.kline-tr {
  display: flex;
  align-items: center;
  height: 52rpx;
  border-top: 1rpx solid var(--c-border);
}

.kline-td {
  flex: 1;
  font-size: 24rpx;
  color: var(--c-ink);
}

/* 涨跌幅靠右对齐，数值等宽对齐更好读 */
.kline-right {
  text-align: right;
}

.kline-th {
  font-size: 22rpx;
  color: var(--c-gray);
}

.up {
  color: var(--c-red);
}

.down {
  color: var(--c-green);
}

/* ===== 语音消息气泡 =====
   内容塞在 user 气泡的 content 插槽里，颜色跟着父级气泡走：
   组件已经把用户气泡的文字色改成白色（见上面的 .t-chat-content 覆写），
   所以这里一律用 inherit / currentColor，不再单独指定 */
.voice-bubble {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-width: 240rpx;
  padding: var(--sp-1) 0;
}

/* 波形：竖条 + 时长。播放中整条点亮并轻微跳动 */
.voice-wave {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  height: 36rpx;
  opacity: 0.6;
}

.voice-bar {
  width: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.voice-bubble--playing .voice-wave {
  opacity: 1;
}

.voice-bubble--playing .voice-bar {
  animation: voice-bar-pulse 1s ease-in-out infinite;
}

/* 错开一点相位，看起来像在连续跳动而不是整排一起闪 */
.voice-bubble--playing .voice-bar:nth-child(3n) {
  animation-delay: 0.15s;
}

.voice-bubble--playing .voice-bar:nth-child(3n + 1) {
  animation-delay: 0.3s;
}

@keyframes voice-bar-pulse {
  0%,
  100% {
    transform: scaleY(0.6);
  }
  50% {
    transform: scaleY(1.3);
  }
}

.voice-duration {
  font-size: 24rpx;
  color: inherit;
  opacity: 0.85;
}

/* ===== 输入栏 ===== */
/* 绝对定位于页面容器内（等价于 fixed，但会随页面一起参与转场动画） */
.sender-wrap {
  position: absolute;
  left: 0;
  right: 0;
  /* bottom 由页面按键盘高度驱动：卡片上移与对话区收窄共用同一份数据 */
  bottom: 0;
  background: var(--bg);
  transition: bottom 0.25s ease;
  /* 胶囊与屏幕两侧留白（--pad-page 与 TDesign 卡片一致）；
     下内边距由内联样式给：键盘弹起时为 0，否则让出安全区 */
  padding: var(--sp-2) var(--pad-page) 0;
  box-sizing: border-box;
}

/* 胶囊本体：一条圆角条，左端模式键、右端发送键，中间是输入区或「按住说话」 */
.sender-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  /* 胶囊整体上移一档（--sp-2 = 16rpx = 8px）。
     注意只能加在胶囊「下方」：容器是底部锚定的，加大上方留白（padding-top）
     只会把对话区挤短，胶囊本身不会动。这段会被 measureSender 量进
     .sender-wrap 的高度，对话区随之收窄同样的量，
     所以「最后一条消息 ↔ 胶囊」的间距不变，只是胶囊离屏幕底边更远了 */
  margin-bottom: var(--sp-2);
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 模式键（语音 / 键盘）：与发送键同规格，比组件自带的 64rpx 放大到 76rpx，更好点按 */
.bar-btn {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--c-fill);
  color: var(--c-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

.bar-btn--hover {
  background: var(--c-hover);
}

/* 输入区：紧贴模式键右侧，多行时随内容长高（textarea auto-height） */
.bar-field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  /* 上下留白把单行文字垂直居中；多行时 auto-height 会把胶囊一起撑高 */
  padding: 14rpx 0;
}

.bar-input {
  width: 100%;
  /* 一行高度打底（line-height 44rpx）：auto-height 的空 textarea 高度可能塌成 0，
     没有热区就点不中、placeholder 也看不见。
     最多两行 = 88rpx，超出后 textarea 内部滚动，不再把对话区顶掉 */
  min-height: 44rpx;
  max-height: 88rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--c-ink);
}

/* 语音态：胶囊中央的「按住说话」 */
.bar-hold {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  border-radius: 999rpx;
  background: var(--c-fill);
  color: var(--c-ink);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 语音没有光标，靠底色 + 轻微缩放告诉用户已经按住了 */
  transition: background 0.15s ease, transform 0.15s ease;
}

.bar-hold--active {
  background: var(--c-tint);
  transform: scale(0.99);
}

/* 发送键：无内容时是灰底，有内容才点亮成主蓝 */
.bar-send {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, opacity 0.2s ease;
}

.bar-send--active {
  background: var(--c-blue);
}

.bar-send--hover {
  opacity: 0.85;
}

/* 加载态：方块代替发送图标（沿用 chat-sender 的「停止」观感） */
.bar-send-stop {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: #ffffff;
}

/* ===== 侧边抽屉内容 ===== */
/* popup 面板本体：popup 不提供宽度，需自定。
   内部分组列表交由 TDesign cell-group 承载（自带卡片外边距与圆角） */
.drawer-body {
  width: 520rpx;
  height: 100%;
  background: var(--c-card);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  /* padding-top 由内联样式提供（避让状态栏） */
  padding: 0 0 var(--sp-2);
  box-sizing: border-box;
  overflow-y: auto;
}

.drawer-head {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  /* 上下留白加大，让品牌头部整体更突出 */
  padding: var(--sp-3) var(--pad-page);
  /* 品牌头部整体上移一点（负 margin 抵消 drawerTop 里多让出的 44px 空间） */
  margin-top: -12rpx;
}

/* TDesign image（Logo） */
.drawer-logo {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
}

.drawer-title-col {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.drawer-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--c-ink);
}

.drawer-sub {
  font-size: 15px;
  color: var(--c-gray);
}

/* 抽屉导航项标题区：去掉默认右边距，让图标+文字整组真正居中 */
.drawer-nav-center {
  margin-right: 0;
}

/* cell 的 note 插槽：大盘数值。指数值与涨跌幅拆成两段，
   flex + gap 在两者间留距离；note 整体右对齐，gap 会把指数往左推一点 */
.market-note {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 16rpx;
  font-size: 13px;
  font-weight: 500;
}

/* 涨跌幅固定最小宽度并右对齐，让四行的百分比纵向对齐成列，指数值随之整体左移 */
.market-pct {
  min-width: 100rpx;
  text-align: right;
}

.market-note.up {
  color: var(--c-red);
}

.market-note.down {
  color: var(--c-green);
}
