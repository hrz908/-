/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  /* 用 100% 而非 100vh：vh 是固定像素，键盘弹起时重算会与键盘动画不同步导致跳变 */
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  /* 自身作为定位容器：输入栏用 absolute 而非 fixed，
     页面转场动画期间不会因 fixed 元素单独定位而与页面错位 */
  position: relative;
}

/* ===== 导航栏 ===== */
.nav-left {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

/* ===== 对话区 ===== */
/* 高度由 JS 精算并固定为像素值：不随视口变化抖动，也不会被子元素撑开 */
.chat-wrap {
  flex: none;
  width: 100%;
  overflow: hidden;
}

.chat-scroll {
  height: 100%;
}

/* 水平留白放在滚动内容上，避免贴到屏幕边缘；
   底部再补一档内边距，滚到底时免责声明不至于贴着容器边。
   overflow: hidden 让容器自成 BFC，子元素的 margin 不会溢出到容器外面 */
.chat-inner {
  padding: 0 var(--sp-3) var(--sp-3);
  overflow: hidden;
}

/* ===== 消息间距 =====
   消息之间统一用上边距（不由组件的 margin-bottom 决定）：
   第一条上方是本容器的上边距，最后一条下方彻底为 0 */
.msg {
  margin-top: var(--sp-4);
}

/* ===== 用户气泡：右对齐，低透明度蓝（取自视觉稿图表蓝 #5B9BEF 的低饱和档） ===== */
.msg--user {
  display: flex;
  justify-content: flex-end;
}

.bubble--user {
  max-width: 80%;
  padding: var(--sp-2) var(--sp-3);
  background: rgba(91, 155, 239, 0.16);
  border-radius: var(--r-tag) var(--r-tag) 0 var(--r-tag);
}

.bubble-text {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ===== AI 气泡：左对齐卡片面 ===== */
.msg--assistant {
  display: flex;
  justify-content: flex-start;
}

.bubble--assistant {
  max-width: 92%;
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-tag) var(--r-tag) var(--r-tag) 0;
}

/* ===== markdown 版式 =====
   容器开 pre-wrap：换行由 utils/markdown.js 合并进行内文本段 */
.md-h {
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.md-h--lg {
  font-size: var(--fs-title);
  margin: var(--sp-2) 0 var(--sp-1);
}

.md-h--sm {
  font-size: var(--fs-body);
  margin: var(--sp-2) 0 var(--sp-1);
}

.md-p {
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 引用：左竖线 + 次级文字（视觉稿 .quote 规格） */
.md-quote {
  margin: var(--sp-2) 0;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-2);
  border-left: 4rpx solid var(--line);
  font-size: var(--fs-aux);
  line-height: 1.7;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-word;
}

.md-hr {
  height: 0;
  margin: var(--sp-3) 0;
  border-top: 1rpx solid var(--line);
}

/* 代码块：等宽 + 次级面 */
.md-code {
  margin: var(--sp-2) 0;
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.md-code-text {
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: var(--fs-aux);
  line-height: 1.6;
  color: var(--ink-2);
  white-space: pre;
}

/* 列表：标记 + 内容两段，嵌套层缩进 */
.md-list {
  margin: var(--sp-2) 0;
}

.md-li {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
}

.md-li--sub {
  margin-left: var(--sp-3);
}

.md-li-marker {
  flex: none;
  min-width: var(--sp-3);
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink-3);
}

.md-li-body {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 表格：div 行模拟（WXSS 无 table 版式需求，flex 更可控） */
.md-table {
  margin: var(--sp-2) 0;
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.md-tr {
  display: flex;
}

/* 行间分隔线：sep 由 utils/markdown.js 按行号算好（WXSS 禁兄弟选择器） */
.md-tr--sep {
  border-top: 1px solid var(--line);
}

.md-tr--head {
  background: var(--surface-2);
  border-bottom: 1px solid var(--line);
}

.md-th,
.md-td {
  flex: 1;
  min-width: 0;
  padding: var(--sp-1) var(--sp-2);
  font-size: var(--fs-aux);
  line-height: 1.5;
}

.md-th {
  color: var(--ink-3);
  font-weight: 500;
}

.md-td {
  color: var(--ink-2);
  word-break: break-word;
}

/* 行内样式 */
.md-i {
  white-space: pre-wrap;
}

.md-strong {
  font-weight: 600;
  color: var(--ink);
}

.md-em {
  font-style: italic;
}

.md-del {
  text-decoration: line-through;
  color: var(--ink-3);
}

/* 行内代码：等宽 + 次级面小底 */
.md-code.md-i {
  padding: 0 var(--sp-1);
  border-radius: 6rpx;
  background: var(--surface-2);
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: 0.9em;
  color: var(--accent);
  white-space: pre-wrap;
}

/* 链接：图表蓝 + 下划线；点击复制（见 onMdLinkTap） */
.md-link {
  color: #5B9BEF;
  text-decoration: underline;
}

/* ===== 行情卡片（内联版，阶段四将迁入 components/finance/quote-card） ===== */
.qcard {
  width: 100%;
}

.qcard-head {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
}

.qcard-name {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
}

.qcard-code {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.qcard-hero {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

/* 价格大号 + 涨跌幅紧随（设计稿：价格 32px 级） */
.qcard-price {
  font-size: var(--fs-price);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.5rpx;
}

.qcard-change {
  font-size: var(--fs-aux);
  font-weight: 600;
}

.qcard-grid {
  display: flex;
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
}

.qgrid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.qgrid-label {
  font-size: var(--fs-min);
  color: var(--ink-3);
}

.qgrid-value {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
}

.qcard-foot {
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--line);
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* ===== 日 K 表格（内联版，阶段四将迁入 components/finance/kline-card） ===== */
.kcard {
  width: 100%;
}

.kcard-head {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
}

.kcard-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
}

.kcard-sub {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.kline-table {
  margin-top: var(--sp-2);
}

.kline-tr {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  border-top: 1rpx solid var(--line);
}

.kline-td {
  flex: 1;
  font-size: var(--fs-aux);
  color: var(--ink);
}

/* 涨跌幅靠右对齐，数值等宽对齐更好读 */
.kline-right {
  text-align: right;
}

.kline-th {
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* 红涨绿跌（国内习惯） */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* ===== 语音消息气泡 =====
   颜色跟着 user 气泡走：一律 inherit / currentColor */
.bubble--voice {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-width: 240rpx;
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  height: 36rpx;
  opacity: 0.6;
}

.voice-bar {
  width: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

/* 播放中整条点亮并轻微跳动 */
.bubble--voice-playing .voice-wave {
  opacity: 1;
}

.bubble--voice-playing .voice-bar {
  animation: voice-bar-pulse 1s ease-in-out infinite;
}

/* 错开一点相位，看起来像在连续跳动而不是整排一起闪 */
.bubble--voice-playing .voice-bar:nth-child(3n) {
  animation-delay: 0.15s;
}

.bubble--voice-playing .voice-bar:nth-child(3n + 1) {
  animation-delay: 0.3s;
}

@keyframes voice-bar-pulse {
  0%,
  100% {
    transform: scaleY(0.6);
  }
  50% {
    transform: scaleY(1.3);
  }
}

.voice-duration {
  font-size: var(--fs-aux);
  color: inherit;
  opacity: 0.85;
}

/* ===== 状态提示（正在思考 / 工具查询 / 重连） =====
   与 AI 气泡同一套视觉语言：卡片面、左上直角，挂在列表底部 */
.status-tip {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  width: fit-content;
  max-width: 80%;
  margin-top: var(--sp-4);
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 0 var(--r-tag) var(--r-tag) var(--r-tag);
}

.status-tip-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* 三个跳动小点：代替 loading 图标，错相延迟形成波浪感 */
.status-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--ink-3);
  animation: status-blink 1.2s infinite ease-in-out;
}

.status-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.status-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes status-blink {
  0%, 60%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* ===== 免责声明（合规兜底条，所有回答底部固定挂载） ===== */
.disclaimer {
  margin-top: var(--sp-4);
  padding: var(--sp-2) var(--sp-3);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  background: rgba(255, 255, 255, 0.02);
  font-size: var(--fs-min);
  line-height: 1.7;
  color: var(--ink-3);
}

/* scroll-into-view 锚点：0 高度，仅用于把列表滚到底 */
.chat-anchor {
  height: 0;
}

/* ===== 输入栏 ===== */
/* 绝对定位于页面容器内（等价于 fixed，但会随页面一起参与转场动画） */
.sender-wrap {
  position: absolute;
  left: 0;
  right: 0;
  /* bottom 由页面按键盘高度驱动：卡片上移与对话区收窄共用同一份数据 */
  bottom: 0;
  background: var(--bg);
  transition: bottom 0.25s ease;
  /* 胶囊与屏幕两侧留白；下内边距由内联样式给：键盘弹起时为 0，否则让出安全区 */
  padding: var(--sp-2) var(--sp-3) 0;
  box-sizing: border-box;
}

/* 胶囊本体：一条圆角条，左端模式键、右端发送键，中间是输入区或「按住说话」 */
.sender-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  /* 胶囊整体上移一档（--sp-2 = 16rpx = 8px）。
     注意只能加在胶囊「下方」：容器是底部锚定的，加大上方留白（padding-top）
     只会把对话区挤短，胶囊本身不会动 */
  margin-bottom: var(--sp-2);
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}

/* 模式键（语音 / 键盘）：比组件自带的 64rpx 放大到 76rpx，更好点按 */
.bar-btn {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

.bar-btn--hover {
  background: var(--line);
}

/* 输入区：紧贴模式键右侧，多行时随内容长高（textarea auto-height） */
.bar-field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  /* 上下留白把单行文字垂直居中；多行时 auto-height 会把胶囊一起撑高 */
  padding: 14rpx 0;
}

.bar-input {
  width: 100%;
  /* 一行高度打底（line-height 44rpx）：auto-height 的空 textarea 高度可能塌成 0，
     没有热区就点不中、placeholder 也看不见。
     最多两行 = 88rpx，超出后 textarea 内部滚动，不再把对话区顶掉 */
  min-height: 44rpx;
  max-height: 88rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--ink);
}

/* 语音态：胶囊中央的「按住说话」 */
.bar-hold {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 语音没有光标，靠底色 + 轻微缩放告诉用户已经按住了 */
  transition: background 0.15s ease, transform 0.15s ease;
}

.bar-hold--active {
  background: rgba(233, 185, 73, 0.14);
  transform: scale(0.99);
}

/* 发送键：无内容时是次级面，有内容才点亮成金色 */
.bar-send {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, opacity 0.2s ease;
}

.bar-send--active {
  background: var(--accent);
}

.bar-send--hover {
  opacity: 0.85;
}

/* 加载态：方块代替发送图标（沿用 chat-sender 的「停止」观感）。
   金色底上改用深色方块，与发送图标同色系 */
.bar-send-stop {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: #20180A;
}

/* ===== 侧边抽屉 ===== */
/* 面板本体由 base-popup 提供（surface 底 + 左滑动画），这里只管内容排版 */
.drawer-body {
  width: 520rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  /* padding-top 由内联样式提供（避让状态栏） */
  padding: 0 0 var(--sp-2);
  box-sizing: border-box;
  overflow-y: auto;
}

.drawer-head {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  /* 上下留白加大，让品牌头部整体更突出 */
  padding: var(--sp-3) var(--sp-3);
  /* 品牌头部整体上移一点（负 margin 抵消 drawerTop 里多让出的空间） */
  margin-top: -12rpx;
}

.drawer-logo {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid var(--line);
}

.drawer-title-col {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.drawer-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.drawer-sub {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.drawer-section {
  padding: 0 var(--sp-3);
}

.drawer-section-title {
  margin-bottom: var(--sp-2);
  font-size: var(--fs-min);
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 导航菜单：分组卡片承载 */
.drawer-menu {
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.drawer-item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  padding: 0 var(--sp-3);
}

/* 行间分隔线：sep 由 JS 按行号算好（WXSS 禁兄弟选择器） */
.drawer-item--sep {
  border-top: 1rpx solid var(--line);
}

.drawer-item--hover {
  background: var(--surface);
}

.drawer-item-text {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
}

/* 今日大盘：分组卡片 + 行 */
.drawer-markets {
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.market-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  min-height: 88rpx;
  padding: 0 var(--sp-3);
}

/* 行间分隔线：sep 由 JS 按行号算好（WXSS 禁兄弟选择器） */
.market-row--sep {
  border-top: 1rpx solid var(--line);
}

.market-name {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* 指数值与涨跌幅拆成两段，gap 留距离；涨红跌绿由 up/down 类着色 */
.market-note {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 500;
}

/* 涨跌幅固定最小宽度并右对齐，让四行的百分比纵向对齐成列 */
.market-pct {
  min-width: 100rpx;
  text-align: right;
}
