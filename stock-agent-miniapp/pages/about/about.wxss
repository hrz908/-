/* 页面只保留 Logo 区与文案微调，信息列表交给 TDesign cell-group / cell */

/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--c-bg);
  position: relative;
  will-change: transform;
}

.content {
  flex: 1;
  min-height: 0;
}

/* ===== 应用标识 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48px 0 28px;
}

/* TDesign image（Logo） */
.logo-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.app-name {
  margin-top: 18px;
  font-size: 24px;
  font-weight: 700;
  color: var(--c-ink);
}

.app-desc {
  margin-top: 6px;
  font-size: 14px;
  color: var(--c-gray);
}

.dedication {
  margin: 32px 0;
  text-align: center;
  font-size: 20px;
  font-weight: 600;
  color: var(--c-blue);
}
