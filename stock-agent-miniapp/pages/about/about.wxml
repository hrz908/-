<!-- 页面结构基于 TDesign：navbar + t-image（Logo）+ cell-group / cell（信息列表）+ toast -->
<view class="page">
  <t-navbar title="关于" left-arrow="{{true}}" placeholder="{{true}}" bind:go-back="goBack" />

  <scroll-view class="content" scroll-y>
    <!-- 应用标识 -->
    <view class="hero">
      <t-image src="/assets/logo.png" mode="aspectFit" class="logo-img" />
      <view class="app-name">Stock Agent</view>
      <view class="app-desc">AI 股票助手</view>
    </view>

    <!-- 版本信息 -->
    <t-cell-group theme="card" bordered="{{true}}">
      <t-cell title="版本" note="1.2.0" bordered="{{true}}">
        <t-icon slot="left-icon" name="info-circle" size="40rpx" color="#2559EB" />
      </t-cell>

      <t-cell title="检查更新" arrow="{{true}}" bind:click="onCheckUpdate">
        <t-icon slot="left-icon" name="refresh" size="40rpx" color="#2559EB" />
      </t-cell>
    </t-cell-group>

    <view class="dedication">deticate to my 溜</view>
  </scroll-view>

  <!-- 轻提示（TDesign toast，替代 wx.showToast） -->
  <t-toast id="t-toast" />
</view>
