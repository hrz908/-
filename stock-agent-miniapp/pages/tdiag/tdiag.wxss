.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--c-bg);
}

.tip {
  margin: var(--sp-3) var(--pad-page);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--sp-2);
  background: var(--c-card);
  font-size: 13px;
  color: var(--c-gray);
}

.result {
  color: var(--c-blue);
}

.btn-wrap {
  margin: var(--sp-3) var(--pad-page);
}
