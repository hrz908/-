<view class="page">
  <t-navbar title="TDesign 诊断" left-arrow="{{true}}" bind:go-back="goBack" />

  <view class="tip">如果以下组件都能看到，说明 TDesign 本身工作正常，问题在 chat 系列组件。</view>

  <t-cell-group title="基础组件">
    <t-cell title="图标" bordered="{{true}}">
      <t-icon slot="left-icon" name="chart-bubble" size="40rpx" color="#2559EB" />
      <t-switch slot="note" value="{{sw}}" bind:change="onSwitch" />
    </t-cell>
    <t-cell title="箭头单元格" note="说明" arrow="{{true}}" bind:click="onClick" />
  </t-cell-group>

  <view class="btn-wrap">
    <t-button theme="primary" block="{{true}}" icon="add" bindtap="onClick">按钮</t-button>
  </view>

  <view class="tip result">结果：{{result || '待确认'}}</view>
</view>
