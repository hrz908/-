/* 深色专业终端的设计变量与全局基线（styles/token.wxss + styles/base.wxss） */
@import "styles/token.wxss";
@import "styles/base.wxss";

/* ===== 间距规格（项目自有 8pt 栅格，与设计系统无关，全局保留） =====
   375pt 基准下 2rpx = 1px。全项目间距只取这六档，不再出现随手写的数字；
   单位一律 rpx。唯一保留 px 的地方：安全区 env() 与系统胶囊对齐的固定值 */
page {
  --sp-1: 8rpx;   /* 4px  图标与文字、紧密元素之间 */
  --sp-2: 16rpx;  /* 8px  卡片内相邻行 */
  --sp-3: 24rpx;  /* 12px 卡片内区块 */
  --sp-4: 32rpx;  /* 16px 区块标准间距：卡片与卡片、卡片与容器边缘 */
  --sp-5: 48rpx;  /* 24px 大区块之间（如列表与底部操作区） */
  --sp-6: 96rpx;  /* 48px 仅用于整屏居中的首屏标识区，普通区块不要用它 */

  /* 语义别名：改规格时只改上面六档，这里的含义不动 */
  --pad-card: var(--sp-4);   /* 卡片内边距 */
  --pad-page: var(--sp-4);   /* 页面左右留白 */
}
