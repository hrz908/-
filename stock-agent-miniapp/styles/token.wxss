/* =============================================================
   设计 Token · 深色专业终端视觉语言
   来源：《股票小助手_前端改造_执行指南》第 5 节 + 金融卡片设计文档
   规则：所有页面 / 组件只允许引用本文件变量，禁止写死颜色与字号；
   自定义组件通过 CSS 变量继承拿到这些值（styleIsolation 默认隔离
   不影响 custom property 透传）。
   ============================================================= */
page {
  /* ---- 背景与层次 ---- */
  --bg: #0B1219;        /* 页面背景 */
  --surface: #141E29;   /* 卡片面 */
  --surface-2: #1B2634; /* 次级面：芯片底、进度槽、骨架块 */
  --line: #26333F;      /* 描边 / 分割线 */

  /* ---- 文字 ---- */
  --ink: #E8EDF2;       /* 主文字 */
  --ink-2: #9AA9B8;     /* 次文字 */
  --ink-3: #6B7A8A;     /* 弱文字 */

  /* ---- 涨跌平：国内习惯红涨绿跌，与欧美相反，不要搞反 ---- */
  --up: #F2555A;
  --down: #1FB87A;
  --flat: #8A97A5;

  /* ---- 强调色：仅用于目标价 / 超预期 / 需关注等行动点，不做装饰 ---- */
  --accent: #E9B949;

  /* ---- 圆角（设计稿 16px / 6px / 8px，按 750rpx = 屏宽 ×2） ---- */
  --r-card: 32rpx;    /* 卡片 */
  --r-tag: 12rpx;     /* 标签 / 芯片 */
  --r-nav-btn: 16rpx; /* 导航按钮 */

  /* ---- 字号（设计稿 32px / 16px / 13px / 10-11px，×2 取 rpx） ----
     正文设计稿为 13px（26rpx），但无障碍硬约束要求 ≥28rpx，
     故上取整到 28rpx；辅助与弱辅助维持 11px / 10px 规格 */
  --fs-price: 64rpx;  /* 32px 价格 */
  --fs-title: 32rpx;  /* 16px 卡片标题 */
  --fs-body: 28rpx;   /* 14px 正文（≥28rpx 底线） */
  --fs-aux: 22rpx;    /* 11px 辅助 */
  --fs-min: 20rpx;    /* 10px 弱辅助：字段说明 / 免责声明 */

  /* ---- 间距（设计稿 14px / 14px / 10px，×2 取 rpx） ---- */
  --sp-card: 28rpx;   /* 卡片间距 */
  --pad-card: 28rpx;  /* 卡片内边距 */
  --gap-grid: 20rpx;  /* 栅格间距 */
}
