/* =============================================================
   设计 Token · 浅色专业金融视觉语言（2026-10-22 由深色终端风整体切换）
   来源：用户提供的三张产品参考图（chat / 自选股 / 提醒）
   规则：所有页面 / 组件只允许引用本文件变量，禁止写死颜色与字号；
   自定义组件通过 CSS 变量继承拿到这些值（styleIsolation 默认隔离
   不影响 custom property 透传）。
   ============================================================= */
page {
  /* ---- 背景与层次（参考图：浅灰页面 + 白卡片 + 细描边 + 轻投影） ---- */
  --bg: #F5F6F8;        /* 页面背景：浅灰 */
  --surface: #FFFFFF;   /* 卡片面 */
  --surface-2: #F2F4F7; /* 次级面：芯片底、进度槽、骨架块 */
  --line: #E8EBF0;      /* 描边 / 分割线 */

  /* ---- 文字 ---- */
  --ink: #181A1C;       /* 主文字：近黑 */
  --ink-2: #5F6875;     /* 次文字 */
  --ink-3: #9AA1AC;     /* 弱文字：字段说明 / 免责声明 */

  /* ---- 涨跌平：国内习惯红涨绿跌，与欧美相反，不要搞反 ---- */
  --up: #F04A4A;
  --down: #1AA97C;
  --flat: #8A97A5;

  /* ---- 强调色：浅色主题的主行动色（蓝）。
       按钮 / 链接 / 激活态 / 用户气泡都用它；
       原深色主题的金色强调色在浅底上对比度不足，整体弃用 ---- */
  --accent: #2559EB;

  /* ---- 状态淡色底与淡色描边（标签 / 药丸 / 图标底，浅底专用） ---- */
  --up-tint: rgba(240, 74, 74, 0.08);
  --up-border: rgba(240, 74, 74, 0.28);
  --down-tint: rgba(26, 169, 124, 0.08);
  --down-border: rgba(26, 169, 124, 0.28);
  --accent-tint: rgba(37, 89, 235, 0.08);
  --accent-border: rgba(37, 89, 235, 0.30);

  /* ---- 投影：浅色主题用「轻投影 + 细描边」表达层次，
       深色主题那套重投影（0.45 黑）在浅底上会发脏 ---- */
  --shadow-card: 0 4rpx 20rpx rgba(16, 24, 40, 0.05);
  --shadow-pop: 0 12rpx 40rpx rgba(16, 24, 40, 0.16);

  /* ---- 圆角（设计稿 16px / 6px / 8px，按 750rpx = 屏宽 ×2） ---- */
  --r-card: 32rpx;    /* 卡片 */
  --r-tag: 12rpx;     /* 标签 / 芯片 */
  --r-nav-btn: 16rpx; /* 导航按钮 */

  /* ---- 字号（设计稿 32px / 16px / 13px / 10-11px，×2 取 rpx） ----
     层级（自上而下）：行情主价 32px > 主数字 28px > 抽屉品牌 20px
     > 卡片标题 / 列表价 16px > 正文 14px > 辅助 / 分区标题 11px > 弱辅助 10px
     正文设计稿为 13px（26rpx），但无障碍硬约束要求 ≥28rpx，
     故上取整到 28rpx；辅助与弱辅助维持 11px / 10px 规格。
     规则：任何字号都必须取用这里的档位，页面里不再写裸数字
     （唯一例外：行内代码这类跟随上下文缩放的相对写法，用 em） */
  --fs-price: 64rpx;  /* 32px 行情卡主价格 */
  --fs-hero: 56rpx;   /* 28px 主数字：总浮动金额 / 提醒计数 / 提醒阈值 */
  --fs-value: 44rpx;  /* 22px 次级主数字：资金流主力净额 */
  --fs-brand: 40rpx;  /* 20px 抽屉品牌名 */
  --fs-title: 32rpx;  /* 16px 卡片标题 */
  --fs-body: 28rpx;   /* 14px 正文（≥28rpx 底线） */
  --fs-aux: 22rpx;    /* 11px 辅助 */
  --fs-min: 20rpx;    /* 10px 弱辅助：字段说明 / 免责声明 */

  /* ---- 间距（设计稿 14px / 14px / 10px，×2 取 rpx） ---- */
  --sp-card: 28rpx;   /* 卡片间距 */
  --pad-card: 28rpx;  /* 卡片内边距 */
  --gap-grid: 20rpx;  /* 栅格间距 */
}
