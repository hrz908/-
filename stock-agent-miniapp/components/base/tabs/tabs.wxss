/* chips 行：底色与卡片一致，激活项用主行动蓝（单一强调色） */
.tabs {
  width: 100%;
  white-space: nowrap;
}

.tabs-track {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-1) 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  /* 触摸目标 ≥ 88rpx */
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

.chip-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 选中态：shadcn primary（--ink 近黑底 + --primary-fg 字）。
   原先用 --accent 蓝，与「强调色只做链接/焦点」的收口规则冲突 */
.chip--on {
  background: var(--ink);
  border-color: var(--ink);
}

.chip--on .chip-text {
  color: var(--primary-fg);
  font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.chip--hover {
  opacity: 0.85;
}
