<scroll-view class="tabs tabs-class" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" scroll-into-view="{{scrollInto}}">
  <view class="tabs-track">
    <view
      wx:for="{{items}}"
      wx:for-item="it"
      wx:for-index="i"
      wx:key="key"
      id="tab-chip-{{i}}"
      class="chip {{i === activeIndex ? 'chip--on' : ''}}"
      hover-class="chip--hover"
      hover-stay-time="{{60}}"
      data-index="{{i}}"
      bindtap="onChipTap"
    >
      <text class="chip-text num">{{it.label}}</text>
    </view>
  </view>
</scroll-view>
