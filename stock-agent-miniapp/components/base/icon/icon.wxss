/* 图标：外层为弹性容器，把内层字形在水平/垂直两轴完全居中；
   这样无论 size 怎么变、外层盒是否方，字形都始终居中且不受容器尺寸影响 */
.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  /* 默认不拦截手势：图标多数放在可点父节点上，由父节点的 hover-class 提供按压反馈 */
  pointer-events: none;
}

/* 字形：填满外层盒，以 contain + center 把 SVG 在盒内两轴居中 */
.icon__glyph {
  width: 100%;
  height: 100%;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
