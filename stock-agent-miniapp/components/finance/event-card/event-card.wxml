<!-- 公司事件卡：时间轴样式，圆点按重要度变色（金=需关注，蓝=常规）；
     每条事件可附原文链接（复制）。文案只陈述事件事实，卡内信息全部左对齐 -->
<view class="fcard card-class">
  <view class="fcard-hd">
    <view class="fcard-title-col">
      <view class="fcard-name">公司动态</view>
      <view class="fcard-code num">{{range}}</view>
    </view>

  </view>

  <view class="evt" wx:for="{{rows}}" wx:for-item="e" wx:key="title">
    <view class="evt-dot {{e.important ? 'evt-dot--gold' : 'evt-dot--blue'}}"></view>
    <view class="evt-body">
      <view class="evt-t">
        <text wx:if="{{e.type}}" class="evt-type">{{e.type}}</text>
        <text class="evt-title">{{e.title}}</text>
      </view>
      <view wx:if="{{e.desc}}" class="evt-s">{{e.desc}}</view>
      <view class="evt-foot">
        <text wx:if="{{e.date}}" class="evt-date num">{{e.date}}</text>
        <text wx:if="{{e.sourceUrl}}" class="evt-src" data-url="{{e.sourceUrl}}" bindtap="onSourceTap">原文链接</text>
      </view>
    </view>
  </view>

  <view wx:if="{{note}}" class="fnote">{{note}}</view>
</view>
