<!-- 估值卡：四列估值指标 + PE 分位进度条；分位低于 30% 标绿「偏低」，
     高于 70% 标红「偏高」（设计文档④的展示规则，只陈述客观事实） -->
<view class="fcard card-class">
  <view class="fcard-hd">
    <view class="fcard-title-col">
      <view class="fcard-name">估值与股息</view>
      <view class="fcard-code">PE(TTM) / PE(静) / PB / PS / PEG / 股息率</view>
    </view>

  </view>

  <view class="fgrid fgrid--flat">
    <view class="fgrid-row">
      <view class="fcell">
        <view class="fcell-k">PE(TTM)</view>
        <view class="fcell-v num">{{peTTMText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">PB</view>
        <view class="fcell-v num">{{pbText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">股息率</view>
        <view class="fcell-v num">{{yieldText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">PEG</view>
        <view class="fcell-v num">{{pegText}}</view>
      </view>
    </view>
  </view>

  <!-- PE 分位进度条：填充色随档位（偏低=绿 / 偏高=红 / 中位=灰） -->
  <view class="pct-row">
    <text class="pct-label">PE分位</text>
    <view class="pct-track">
      <view class="pct-fill pct-fill--{{barLevel}}" style="width: {{barWidth}};"></view>
    </view>
    <text class="pct-value num {{barLevel}}">{{barLabel}}</text>
  </view>

  <view class="fgrid fgrid-row--gap">
    <view class="fgrid-row">
      <view class="fcell">
        <view class="fcell-k">PE(静态)</view>
        <view class="fcell-v num">{{peStaticText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">PS</view>
        <view class="fcell-v num">{{psText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">总市值</view>
        <view class="fcell-v num">{{capText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">近5年分位</view>
        <view class="fcell-v num">{{pct5yText}}</view>
      </view>
    </view>
  </view>

  <!-- 口径标注（合规要求）：分位区间 + 行业均值对比 -->
  <view class="fnote">
    <view>分位口径：PE(TTM) 近3年 / 近5年 历史分位；行业均值 PE {{industryPeText}} · PB {{industryPbText}} · 股息率 {{industryYieldText}}</view>
    <view wx:if="{{note}}">{{note}}</view>
  </view>
</view>
