<!-- 财报速览卡：营收 / 归母净利 / 经营现金流按「龙虎榜行」格式排——
     名称占 1/2 靠左，金额与同比合计占 1/2 且右对齐，行间发丝线，无小标题；
     底部四列比率栅格等距居中；最下方补数据日期（与其它卡片同一写法） -->
<view class="fcard card-class">
  <view class="fcard-hd">
    <view class="fcard-title-col">
      <view class="fcard-name">{{periodLabel}} · 业绩速览</view>
    </view>

  </view>

  <!-- 三项主数据：与龙虎榜数据行同规格——名称占 1/2 靠左，
       后面金额与同比合计占 1/2（各 1/4）且右对齐，行间发丝线 -->
  <view class="rep-list">
    <view class="rep-row">
      <text class="rep-k">营业收入</text>
      <view class="rep-v">
        <text class="num rep-amt">{{revenueRow.value}}</text>
        <text class="num rep-yoy {{revenueRow.yoyDir}}">{{revenueRow.yoy}}</text>
      </view>
    </view>

    <view class="rep-row">
      <text class="rep-k">归母净利</text>
      <view class="rep-v">
        <text class="num rep-amt">{{profitRow.value}}</text>
        <text class="num rep-yoy {{profitRow.yoyDir}}">{{profitRow.yoy}}</text>
      </view>
    </view>

    <view class="rep-row">
      <text class="rep-k">经营现金流</text>
      <view class="rep-v">
        <text class="num rep-amt">{{cashRow.value}}</text>
        <text class="num rep-yoy {{cashRow.yoyDir}}">{{cashRow.yoy}}</text>
      </view>
    </view>
  </view>

  <view class="fgrid">
    <view class="fgrid-row">
      <view class="fcell">
        <view class="fcell-k">毛利率</view>
        <view class="fcell-v num">{{grossMarginText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">净利率</view>
        <view class="fcell-v num">{{netMarginText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">ROE</view>
        <view class="fcell-v num">{{roeText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">EPS</view>
        <view class="fcell-v num">{{epsText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{note}}" class="fnote">{{note}}</view>
</view>
