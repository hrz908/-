@import "../_card.wxss";

/* 条形数据行：标签 + 槽 + 值（值列固定宽度，右对齐） */
.bar-row {
  display: flex;
  align-items: center;
  gap: var(--gap-grid);
  margin-top: var(--sp-2);
}

.bar-row:first-of-type {
  margin-top: var(--sp-3);
}

.bar-lb {
  flex: none;
  width: 128rpx;
  font-size: var(--fs-aux);
  color: var(--ink-2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.bar-track {
  flex: 1;
  height: 12rpx;
  border-radius: var(--r-tag);
  background: var(--surface-2);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: var(--r-tag);
}

/* 三条主数据配色（视觉稿规格；原先写 linear-gradient 既违反 DESIGN.md 禁止清单，
   两个端点变量又都未定义导致填充透明；收敛为纯色 + token 收口） */
.bar-fill--revenue {
  background: var(--accent-deep);
}

.bar-fill--profit {
  background: var(--warn);
}

.bar-fill--cash {
  background: var(--flat);
}

.bar-v {
  flex: none;
  width: 220rpx;
  text-align: right;
  font-size: var(--fs-aux);
  color: var(--ink);
}

.bar-yoy {
  margin-left: var(--sp-1);
}
