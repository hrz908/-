@import "../_card.wxss";

/* 卡片标题居中：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部口径说明（一致预期 / 报告期口径）左对齐 */
.fnote {
  text-align: left;
}

/* 条形数据行：标签 + 槽 + 值（值列固定宽度，右对齐） */
.bar-row {
  display: flex;
  align-items: center;
  gap: var(--gap-grid);
  margin-top: var(--sp-2);
}

.bar-row:first-of-type {
  margin-top: var(--sp-3);
}

.bar-lb {
  flex: none;
  width: 128rpx;
  font-size: var(--fs-aux);
  color: var(--ink-2);
  word-break: break-word;        /* 不裁剪：超长标签换行完整显示 */
}

.bar-track {
  flex: 1;
  height: 12rpx;
  border-radius: var(--r-tag);
  background: var(--surface-2);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: var(--r-tag);
}

/* 三条主数据配色（视觉稿规格；原先写 linear-gradient 既违反 DESIGN.md 禁止清单，
   两个端点变量又都未定义导致填充透明；收敛为纯色 + token 收口） */
.bar-fill--revenue {
  background: var(--accent-deep);
}

.bar-fill--profit {
  background: var(--warn);
}

.bar-fill--cash {
  background: var(--flat);
}

.bar-v {
  flex: none;
  /* 加宽数值列：原 220rpx 放不下「1302.46亿 +16.85%」导致换行跳行。
     数值列变宽后，中间的 .bar-track（flex:1）会自动变短，符合预期。 */
  width: 280rpx;
  white-space: nowrap;          /* 兜底：数值与同比始终同一行，绝不跳行 */
  text-align: right;
  font-size: var(--fs-aux);
  color: var(--ink);
}

.bar-yoy {
  margin-left: var(--sp-1);
}

/* 信息居中：条形行标签与数值列（数值列原右对齐改居中） */
.bar-lb {
  text-align: center;
}

.bar-v {
  text-align: center;
}
