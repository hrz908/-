@import "../_card.wxss";

/* 卡片标题居中：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（数据日期等）左对齐 */
.fnote {
  text-align: left;
}

/* 周期 chips：横向不换行，激活项用主行动蓝描边（单一强调色） */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-top: var(--sp-3);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 var(--sp-2);
  box-sizing: border-box;
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

.chip-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* 选中态：shadcn primary（--ink 近黑底 + --primary-fg 字），与 base-tabs 一致 */
.chip--on {
  background: var(--ink);
  border-color: var(--ink);
}

.chip--on .chip-text {
  color: var(--primary-fg);
  font-weight: 600;
}

/* K 线图：≥180rpx（设计稿②布局要点），SVG 拉伸铺满 */
.chart {
  margin-top: var(--sp-3);
  width: 100%;
  height: 200rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* ===== 区间指标行：等距居中；支撑压力行：整行靠左 =====
   等距居中：区间涨幅 / 振幅 / MA5 / 量比 四格居中（规则在 _card.wxss）。
   支撑·压力：整行文案靠左，两项之间用「·」点号隔开（同行情卡底部口径）。
   K 线图本身（.chart）是唯一的整幅图形，不参与对齐。 */
.sr-row {
  margin-top: var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--ink-2);
  text-align: left;
}

.fnote {
  text-align: left;              /* 底部说明左对齐 */
}
