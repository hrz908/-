# 生产环境变量模板：cp .env.production.example .env 后填值
# 真实的 .env 不进仓库，只存在于服务器 /opt/stock-agent/deploy/.env
# 必填项留空待填；下面有默认值的选填项别清空（空字符串会原样注入容器，Python 端不回落默认值）

# ===== 必填 =====
ENV=prod
# 三个密码用 openssl rand -hex 生成，只用十六进制（特殊字符会破坏数据库 DSN）
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# mp.weixin.qq.com → 开发管理 → 开发设置
WECHAT_APPID=
WECHAT_SECRET=
# 硅基流动，LLM 与 ASR 共用
OPENAI_API_KEY=

# ===== 选填（保持默认值）=====
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SMALL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# 与 OPENAI_EMBED_MODEL 必须同模型同维度，否则 agent / ingest 两端向量空间不一致
OPENAI_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# 4B 默认 2560，显式降到 1536：>2000 的 vector 列建不了 HNSW 索引
EMBED_DIM=1536
RAG_THRESHOLD=0.2
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
JWT_TTL=168h
ALLOW_ORIGINS=*

# Tushare Pro 数据增强（个人中心-接口 Token），留空则不注册相关工具
TUSHARE_TOKEN=

# agent 回调 Go 网关的服务 JWT，留空则行情类工具 401；改了 JWT_SECRET 需重签
GO_SERVER_TOKEN=

# 企业微信提醒推送：三项齐全才生效
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=

# 群机器人 Webhook（群设置 → 群机器人 → 添加）；不需要可信 IP，可与应用消息并存
WECOM_WEBHOOK=
