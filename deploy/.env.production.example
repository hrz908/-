# ===== 生产环境变量模板 =====
# 用法：cp .env.production.example .env，然后填下面的值。
# .env 已被 .gitignore 忽略，不会进仓库；服务器上只存在于 /opt/stock-agent/deploy/.env。
#
# Go server 的配置映射规则（server/internal/config/config.go）：
#   环境变量名 = 配置键大写 + 点转下划线，无前缀。例如 agent.qps -> AGENT_QPS。
#   ENV=prod 时启动强制要求：JWT_SECRET（非默认值）+ WECHAT_APPID + WECHAT_SECRET。
# agent 服务（agent/config.py）读：OPENAI_API_BASE / OPENAI_API_KEY / LLM_MODEL /
#   SMALL_MODEL / EMBED_MODEL / RAG_THRESHOLD / GO_SERVER_URL / GO_SERVER_TOKEN /
#   DATABASE_URL / REDIS_URL。

# ---------- 必填 ----------

# 部署环境：prod 会拒绝默认密钥启动（安全底线，别改）
ENV=prod

# JWT 签名密钥：openssl rand -hex 32 生成一个，千万别用默认值
JWT_SECRET=

# 数据库密码（postgres 容器初始化时生效，改密码需要连卷一起重建）
POSTGRES_PASSWORD=

# Redis 密码
REDIS_PASSWORD=

# 微信小程序凭据（mp.weixin.qq.com → 开发管理 → 开发设置）
WECHAT_APPID=wx6da8b7aed78257af
WECHAT_SECRET=

# LLM 上游（硅基流动；ASR 语音识别默认复用 OPENAI_API_KEY）
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_API_KEY=

# ---------- 选填（有默认值，一般不改） ----------

# LLM / Embedding 模型
LLM_MODEL=deepseek-ai/DeepSeek-V3
SMALL_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBED_MODEL=BAAI/bge-m3

# RAG 相关性阈值（余弦相似度）
RAG_THRESHOLD=0.2

# 语音识别模型
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# JWT 有效期
JWT_TTL=168h

# CORS 允许的 Origin，逗号分隔；小程序场景一般用不到浏览器 CORS，保持 *
ALLOW_ORIGINS=*

# agent 回调 Go 网关受保护接口用的服务间 token（一个合法 JWT）。
# 获取方式：先 deploy 起服务 → 用微信登录拿一个用户 token 填这里 → restart。
# 留空后果：agent 的行情工具（自选股查询等）回调会 401，对话与行情卡仍可用。
GO_SERVER_TOKEN=

# ---------- 企业微信提醒推送（建议配置，收掉公开仓库里的硬编码默认值） ----------
# 启用条件（server/internal/wecom.Enabled）：三项齐全，缺一不生效。
# config.go 的 setDefaults 里硬编码了默认值且仓库公开，secret 按已泄露处理，请：
#   1. 企业微信管理后台 → 应用管理 → 自建应用 → 「查看」→ 重置 Secret（旧值立即作废）
#   2. 三项全部填入下面（CorpID / AgentID 在同一页面复制）
#   3. sudo bash scripts/deploy.sh restart（只改 .env 不重启不生效）
# 注意：secret 的值只填在服务器上的 deploy/.env，不要写进本模板（本文件进公开仓库）
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=
